<% import Cherry.Theme.Helpers %><%= if @doc.path == "index.html" do %><section class="bellows-hero">
<h1 class="bellows-word"><%= h(@doc.meta.title) %></h1>
<%= if desc = Map.get(@doc.meta, :description) || @site.description do %><p class="bellows-lede"><%= h(desc) %></p>
<% end %></section>
<article>
<%= @doc.html %>
</article>
<% else %><article>
<%= @doc.html %>
</article>
<% end %>
