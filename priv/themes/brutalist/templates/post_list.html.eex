<% import Cherry.Theme.Helpers %><h1>Blog</h1>
<table class="post-table">
<thead><tr><th>Date</th><th>Title</th><th>Tags</th></tr></thead>
<tbody>
<%= for post <- @posts do %><tr>
<td><time datetime="<%= Date.to_iso8601(post.meta.date) %>"><%= Date.to_iso8601(post.meta.date) %></time></td>
<td><a href="<%= post.url %>"><%= h(post.meta.title) %></a></td>
<td><%= Enum.join(post.meta.tags, ", ") |> h() %></td>
</tr>
<% end %></tbody>
</table>
