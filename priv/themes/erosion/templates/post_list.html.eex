<% import Cherry.Theme.Helpers %><h1>Blog</h1>
<ul class="post-list post-grid">
<%= for post <- @posts do %><li>
<time datetime="<%= Date.to_iso8601(post.meta.date) %>"><%= format_date(post.meta.date) %></time>
<a href="<%= post.url %>"><%= h(post.meta.title) %></a>
<%= if desc = Map.get(post.meta, :description) do %><p class="post-desc"><%= h(desc) %></p>
<% end %></li>
<% end %></ul>
