<% import Cherry.Theme.Helpers %><% alias Cherry.CV.Skill %><article class="cv cv-careers">
<header class="cv-header">
<h1><%= h(@cv.profile.name) %></h1>
<%= if @cv.profile.headline do %><p class="cv-headline"><%= h(@cv.profile.headline) %></p>
<% end %><p class="cv-contact"><%= if @cv.profile.location do %><span><%= h(@cv.profile.location) %></span><% end %><%= for link <- @cv.profile.links do %><a href="<%= link.url %>"><%= h(link.label) %></a><% end %><%= if @cv.profile.email do %><a href="mailto:<%= @cv.profile.email %>"><%= h(@cv.profile.email) %></a><% end %></p>
<p class="cv-updated">Updated <%= Calendar.strftime(@cv.updated, "%B %Y") %><span class="cv-json-link"> · <a href="<%= href(@site, "cv.json") %>">cv.json</a></span></p>
</header>
<nav class="view-switch" aria-label="Profile views"><span aria-current="page">CV</span><a href="<%= href(@site, "cv/timeline/") %>">Timeline</a></nav>
<div class="cv-columns">
<div class="cv-main">
<%= if @cv.positions != [] do %><section class="cv-section">
<h2>Experience</h2>
<%= for position <- @cv.positions do %><article class="cv-entry">
<h3><%= h(position.title) %> <span class="entry-org">· <%= h(position.org) %></span></h3>
<p class="entry-meta"><%= format_range(position.started, position.ended) %><%= if position.location do %> · <%= h(position.location) %><% end %></p>
<%= if cv_highlights(position) != [] do %><ul class="entry-highlights">
<%= for highlight <- cv_highlights(position) do %><li><%= h(highlight) %></li>
<% end %></ul>
<% end %><%= if position.tags != [] do %><ul class="cv-tags">
<%= for tag <- position.tags do %><li><a href="<%= href(@site, "story/" <> tag_slug(tag) <> "/") %>"><%= h(tag) %></a></li>
<% end %></ul>
<% end %></article>
<% end %></section>
<% end %><%= if @cv.projects != [] do %><section class="cv-section">
<h2>Projects</h2>
<%= for project <- @cv.projects do %><article class="cv-entry">
<h3><%= h(project.title) %></h3>
<p class="entry-meta"><%= format_range(project.started, project.ended) %><%= for link <- project.links do %> · <a href="<%= link.url %>"><%= h(link.label) %></a><% end %></p>
<%= if cv_highlights(project) != [] do %><ul class="entry-highlights">
<%= for highlight <- cv_highlights(project) do %><li><%= h(highlight) %></li>
<% end %></ul>
<% end %><%= if project.tags != [] do %><ul class="cv-tags">
<%= for tag <- project.tags do %><li><a href="<%= href(@site, "story/" <> tag_slug(tag) <> "/") %>"><%= h(tag) %></a></li>
<% end %></ul>
<% end %></article>
<% end %></section>
<% end %><%= if @cv.talks != [] do %><section class="cv-section">
<h2>Talks</h2>
<%= for talk <- @cv.talks do %><article class="cv-entry">
<h3><%= h(talk.title) %></h3>
<p class="entry-meta"><%= h(talk.event) %> · <%= format_month(talk.date) %></p>
</article>
<% end %></section>
<% end %><%= if @cv.education != [] do %><section class="cv-section">
<h2>Education</h2>
<%= for education <- @cv.education do %><article class="cv-entry">
<h3><%= h(education.title) %> <span class="entry-org">· <%= h(education.institution) %></span></h3>
<p class="entry-meta"><%= format_range(education.started, education.ended) %></p>
</article>
<% end %></section>
<% end %></div>
<aside class="cv-side">
<%= if @cv.skills != [] do %><section class="cv-section cv-side-section">
<h2>Top skills</h2>
<ul class="cv-skills">
<%= for skill <- @cv.skills do %><li><a href="<%= href(@site, "story/" <> tag_slug(skill.tag) <> "/") %>"><%= h(skill.tag) %></a> <span class="cv-skill-years"><%= Skill.format_years(skill) %></span></li>
<% end %></ul>
</section>
<% end %><%= if @cv.oss != [] do %><section class="cv-section cv-side-section">
<h2>Open source</h2>
<ul class="oss-list">
<%= for oss <- @cv.oss do %><li><a href="<%= oss.repo %>"><%= h(oss.title) %></a> <span class="oss-role"><%= h(oss.role) %></span></li>
<% end %></ul>
</section>
<% end %></aside>
</div>
</article>
