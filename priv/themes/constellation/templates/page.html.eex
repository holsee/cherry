<% import Cherry.Theme.Helpers %><%= if @doc.path == "index.html" do %><section class="hero hero-home">
<%= if @doc.meta.title != @site.title do %><p class="hero-kicker"><%= h(@site.title) %></p>
<% end %><h1 class="hero-title"><%= h(@doc.meta.title) %></h1>
<%= if desc = Map.get(@doc.meta, :description) || @site.description do %><p class="hero-lede"><%= h(desc) %></p>
<% end %><a class="hero-cue" href="#read" aria-label="Scroll to the writing"><span></span></a>
</section>
<article id="read">
<%= @doc.html %>
</article>
<% else %><article>
<%= @doc.html %>
</article>
<% end %>