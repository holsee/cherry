<% import Cherry.Theme.Helpers %><%= if @doc.path == "index.html" do %><section class="hero hero-home">
<h1 class="hero-title"><%= h(@doc.meta.title) %></h1>
<%= if desc = Map.get(@doc.meta, :description) || @site.description do %><p class="hero-lede"><%= h(desc) %></p>
<% end %><span class="hero-rule" aria-hidden="true"></span>
</section>
<article>
<%= @doc.html %>
</article>
<% else %><article>
<%= @doc.html %>
</article>
<% end %>
