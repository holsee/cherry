<% import Cherry.Theme.Helpers %><h1>Blog</h1>
<%= for {year, posts} <- Enum.group_by(@posts, & &1.meta.date.year) |> Enum.sort_by(&elem(&1, 0), :desc) do %><section class="post-year">
<h2 class="year-head"><%= year %></h2>
<ul class="post-list">
<%= for post <- posts do %><li>
<time datetime="<%= Date.to_iso8601(post.meta.date) %>"><%= Calendar.strftime(post.meta.date, "%-d %B") %></time>
<a href="<%= post.url %>"><%= h(post.meta.title) %></a>
</li>
<% end %></ul>
</section>
<% end %>
