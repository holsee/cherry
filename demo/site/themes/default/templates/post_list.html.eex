<%!-- cherry:eject theme=default version=0.1.0 sha256=8abba9f19ccf6e3df80e9883c1c8e30fffe73738d9022bd6e2d916ec971e0e95 --%>
<% import Cherry.Theme.Helpers %><h1>Writing</h1>
<p>Notes on the BEAM, backpressure, and the long tail of production, newest first.</p>
<%= for {year, posts} <- @posts |> Enum.group_by(& &1.meta.date.year) |> Enum.sort_by(fn {year, _posts} -> year end, :desc) do %><section class="post-year">
<h2><%= year %></h2>
<ul class="post-list">
<%= for post <- posts do %><li>
<time datetime="<%= Date.to_iso8601(post.meta.date) %>"><%= Date.to_iso8601(post.meta.date) %></time>
<a href="<%= post.url %>"><%= h(post.meta.title) %></a>
<%= if post.meta[:description] do %><span class="post-summary"><%= h(post.meta.description) %></span>
<% end %></li>
<% end %></ul>
</section>
<% end %>
