{
  "name": "Cherry",
  "build": { "dockerfile": "Dockerfile" },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "mounts": [
    "source=cherry-mix-home,target=/opt/mix,type=volume",
    "source=cherry-hex-home,target=/opt/hex,type=volume"
  ],
  "forwardPorts": [4000],
  "postCreateCommand": "sh -c '[ -f mix.exs ] && mix deps.get || true'",
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "extensions": [
        "jakebecker.elixir-ls",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
